# Copiare in .env.local per lo sviluppo locale su Windows/macOS/Linux.
# Il DB e Redis girano nei container Docker (porte 5434/6380 via docker-compose.override.yml).
DATABASE_URL=postgresql://naboat:cambia_questa_password_lunga_32char@127.0.0.1:5434/naboat?schema=public
REDIS_URL=redis://127.0.0.1:6380
AUTH_SECRET=chiave-di-sviluppo-locale-sostituire-0123456789
APP_URL=http://localhost:3000

# Turnstile (vuoti = verifica anti-bot disattivata in locale)
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# Email via SMTP Aruba. In locale lasciare vuoti: i messaggi vengono solo loggati.
# Sul VPS compilare con la casella del dominio (smtps.aruba.it, porta 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NaBoat <noreply@naboat.it>

# Requisiti di sicurezza (in locale lasciare false per non bloccarsi)
REQUIRE_2FA=false
REQUIRE_EMAIL_VERIFY=false

# Superadmin creato da `npm run db:seed`. Imposta una password lunga e non prevedibile
# (obbligatoria: il seed non ha più un valore predefinito) e conservala fuori dal codice.
SUPERADMIN_EMAIL=admin@naboat.it
SUPERADMIN_PASSWORD=cambia_questa_password_admin
