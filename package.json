{
  "name": "naboat-gestionale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:test": "node prisma/seed-test.mjs",
    "demo:verifica": "node scripts/demo-pulisci.mjs",
    "demo:pulisci": "node scripts/demo-pulisci.mjs --conferma",
    "demo:proteggi": "node scripts/demo-proteggi.mjs",
    "backup:offsite": "node scripts/offsite-backup.mjs",
    "backup:ftp": "node scripts/backup-ftp.mjs",
    "backup:verifica": "node scripts/backup-verifica.mjs"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@prisma/client": "^5.18.0",
    "basic-ftp": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "nodemailer": "^10.0.10",
    "react": "^19.0.8",
    "react-dom": "^19.0.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
