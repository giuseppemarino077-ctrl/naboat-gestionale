# Copiare in .env sul VPS (chmod 600). Mai committare .env reale.
POSTGRES_USER=naboat
POSTGRES_PASSWORD=cambia_questa_password_lunga_32char
POSTGRES_DB=naboat
DATABASE_URL=postgresql://naboat:cambia_questa_password_lunga_32char@db:5432/naboat?schema=public
REDIS_URL=redis://redis:6379
NEXT_PUBLIC_API_BASE=
# Segreto firma sessioni: >=32 caratteri casuali (openssl rand -hex 32)
AUTH_SECRET=cambia_auth_secret_32char

# URL pubblico dell'app (usato nei link email)
APP_URL=https://app.naboat.it

# Foto barche: local (disco VPS, volume ./uploads) oppure s3 (Aruba Object Storage)
STORAGE_DRIVER=local
S3_PUBLIC_BASE_URL=
# Archivio privato (patenti, verbali): NON deve stare in una cartella pubblica.
# Sul VPS montare un volume dedicato (compose: ./uploads-privati:/app/uploads-privati).
PRIVATE_UPLOADS_DIR=/app/uploads-privati

# --- Copie di sicurezza ---
# Cartella locale dei dump sul VPS e retention (usata anche dalle copie esterne).
BACKUP_DIR=./backups/completi
BACKUP_KEEP_DAYS=30

# Destinazione 1 (inclusa nel piano): Aruba Object Storage / S3.
# Serve anche per le foto se STORAGE_DRIVER=s3. Usata da: npm run backup:offsite
S3_ENDPOINT=
S3_REGION=it-mil1
S3_BUCKET=naboat
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BACKUP_PREFIX=db-backups/

# Destinazione 2 (gratuita): hosting Aruba del dominio, cartella dedicata via FTP.
# Usata da: npm run backup:ftp
# La cartella NON deve stare dentro la cartella pubblica del sito.
FTP_HOST=ftp.naboat.it
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_SECURE=true
FTP_CARTELLA=/backup-naboat

# Email transazionale via SMTP (casella Aruba del dominio: smtps.aruba.it, porta 465).
# Se SMTP_HOST/SMTP_USER/SMTP_PASS sono vuoti, i link vengono solo loggati (dev).
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@naboat.it
SMTP_PASS=cambia_questa_password_casella
MAIL_FROM=NaBoat <noreply@naboat.it>

# Turnstile (Cloudflare). Se TURNSTILE_SECRET è vuoto la verifica è disattivata.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITEKEY=

# Hardening (true in produzione)
REQUIRE_2FA=true
REQUIRE_EMAIL_VERIFY=true

# Abbonamento stagionale: account Stripe di NaBoat (i soldi vanno tutti a NaBoat).
# Se vuoti, il pagamento con carta dell'abbonamento è disattivato e si attiva a mano dal pannello.
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_WEBHOOK_SECRET=

# Promemoria automatici: segreto per l'avvio da cron (impostare una stringa lunga e casuale).
# Sul VPS:  0 18 * * * curl -fsS -X POST https://app.naboat.it/api/v1/promemoria/invia -H "x-cron-secret: <segreto>"
CRON_SECRET=

# Seed superadmin iniziale
SUPERADMIN_EMAIL=admin@naboat.it
SUPERADMIN_PASSWORD=cambia_questa_password_admin
